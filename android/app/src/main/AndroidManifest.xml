<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Wajib untuk memicu installer sistem dari dalam aplikasi (fitur
         Periksa Pembaruan) — tanpa ini Android 8+ menolak Intent instal APK
         yang dipicu oleh aplikasi lain (bukan Play Store/toko aplikasi). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Izin untuk fitur Kunci Aplikasi berbasis Biometrik (Sidik Jari / Wajah) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:label="Cek PBB Cianjur"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Deep link untuk Tautan Penyimpanan Bersama (Custom Scheme) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="cekpbb"
                    android:host="storage" />
            </intent-filter>

            <!-- App Link untuk Tautan Penyimpanan Bersama via Web GitHub Pages -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="ikbalgumilar.github.io"
                    android:pathPrefix="/Cek-PBB-Cianjur/connect" />
            </intent-filter>

            <!-- Intent Filter untuk membuka berkas DHKP (.dkhp / .dhkp / .dat) dari WhatsApp, File Manager, dll -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.dkhp" />
                <data android:pathPattern=".*\\.DKHP" />
                <data android:pathPattern=".*\\.dhkp" />
                <data android:pathPattern=".*\\.DHKP" />
                <data android:pathPattern=".*\\.dat" />
                <data android:pathPattern=".*\\.DAT" />
                <data android:pathSuffix=".dkhp" />
                <data android:pathSuffix=".DKHP" />
                <data android:pathSuffix=".dhkp" />
                <data android:pathSuffix=".DHKP" />
                <data android:pathSuffix=".dat" />
                <data android:pathSuffix=".DAT" />
            </intent-filter>

            <!-- Intent Filter untuk aplikasi (seperti WhatsApp) yang mengirim MIME type application/octet-stream -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.dkhp" />
                <data android:pathPattern=".*\\.DKHP" />
                <data android:pathPattern=".*\\.dhkp" />
                <data android:pathPattern=".*\\.DHKP" />
                <data android:pathPattern=".*\\.dat" />
                <data android:pathPattern=".*\\.DAT" />
                <data android:pathSuffix=".dkhp" />
                <data android:pathSuffix=".DKHP" />
                <data android:pathSuffix=".dhkp" />
                <data android:pathSuffix=".DHKP" />
                <data android:pathSuffix=".dat" />
                <data android:pathSuffix=".DAT" />
            </intent-filter>

            <!-- Intent Filter untuk File Manager tanpa MIME type (berdasarkan host & path/suffix) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.dkhp" />
                <data android:pathPattern=".*\\.DKHP" />
                <data android:pathPattern=".*\\.dhkp" />
                <data android:pathPattern=".*\\.DHKP" />
                <data android:pathPattern=".*\\.dat" />
                <data android:pathPattern=".*\\.DAT" />
                <data android:pathSuffix=".dkhp" />
                <data android:pathSuffix=".DKHP" />
                <data android:pathSuffix=".dhkp" />
                <data android:pathSuffix=".DHKP" />
                <data android:pathSuffix=".dat" />
                <data android:pathSuffix=".DAT" />
            </intent-filter>

            <!-- Intent Filter untuk format berkas arsip zip yang terkait paket DHKP -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:pathSuffix=".dkhp" />
                <data android:pathSuffix=".dat" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:pathSuffix=".dkhp" />
                <data android:pathSuffix=".dat" />
            </intent-filter>

            <!-- Intent Filter saat pengguna memilih opsi "Bagikan" / "Share" berkas dari aplikasi lain -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/apk_file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Supaya bisa mendeteksi & membuka aplikasi m-banking/e-wallet yang
             terpasang untuk fitur "Buka Aplikasi Bank" di layar Virtual
             Account (lihat MainActivity.launchApp). Android 11+ menyembunyikan
             daftar aplikasi terpasang secara default (package visibility). -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
        </intent>
    </queries>
</manifest>
